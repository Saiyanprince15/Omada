// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserEventStatus {
  registered
  looking_for_team
  in_matchmaking
  in_provisional_team
  in_forming_team
  in_finalized_team
  withdrawn
}

enum TeamStatus {
  forming
  finalized
  locked
  dissolved
}

enum ProvisionalTeamStatus {
  pending
  accepted
  dissolved
  expired
  converted
}

enum ProvisionalMemberStatus {
  pending
  accepted
  rejected
  left
  expired
  replaced
}

enum RequestType {
  join_request
  team_invite
  personal_invite
}

enum RequestStatus {
  pending
  accepted
  rejected
  cancelled
  expired
}

enum ChatRoomType {
  provisional
  permanent
}

enum ChatRoomStatus {
  active
  archived
  deleted
}

enum MessageType {
  text
  system
  file
}

enum EventType {
  hackathon
  academic_project
  competition
  research_project
  other
}

enum EventStatus {
  draft
  registration_open
  registration_closed
  in_progress
  completed
  cancelled
}

enum ConstraintType {
  hard
  soft
}

enum TeamSource {
  manual
  auto_match
}

enum TeamMemberRole {
  owner
  admin
  member
}

enum RequirementPriority {
  must_have
  nice_to_have
}

enum RequirementType {
  skill
  role
}

enum MatchingRoundStatus {
  running
  completed
  failed
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  displayName         String    @map("display_name")
  avatarUrl           String?   @map("avatar_url")
  bio                 String?
  isVerified          Boolean   @default(false) @map("is_verified")
  isAdmin             Boolean   @default(false) @map("is_admin")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  // Relations
  skills            UserSkill[]
  interests         UserInterest[]
  preferredRoles    UserPreferredRole[]
  organizedEvents   Event[]                @relation("EventOrganizer")
  eventParticipations EventParticipant[]
  ownedTeams        Team[]                 @relation("TeamOwner")
  teamMemberships   TeamMember[]
  provisionalMemberships ProvisionalTeamMember[]
  sentRequests      RequestInvitation[]    @relation("RequestSender")
  receivedRequests  RequestInvitation[]    @relation("RequestRecipient")
  sentMessages      ChatMessage[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model UserSkill {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  skillName       String   @map("skill_name")    // normalized
  skillDisplay    String   @map("skill_display")  // user-entered
  proficiency     Int      // 1-5
  yearsExperience Decimal? @map("years_experience") @db.Decimal(3, 1)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([skillName])
  @@map("user_skills")
}

model UserInterest {
  id              String @id @default(uuid())
  userId          String @map("user_id")
  interestName    String @map("interest_name")
  interestDisplay String @map("interest_display")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interestName])
  @@map("user_interests")
}

model UserPreferredRole {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  roleName    String @map("role_name")
  roleDisplay String @map("role_display")
  priority    Int    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleName])
  @@map("user_preferred_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  family    String    // Token family for rotation tracking
  used      Boolean   @default(false)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────

model Event {
  id                  String      @id @default(uuid())
  organizerId         String      @map("organizer_id")
  name                String
  description         String?
  eventType           EventType   @map("event_type")
  registrationOpens   DateTime?   @map("registration_opens")
  registrationCloses  DateTime?   @map("registration_closes")
  eventStarts         DateTime?   @map("event_starts")
  eventEnds           DateTime?   @map("event_ends")
  matchmakingEnabled  Boolean     @default(true) @map("matchmaking_enabled")
  autoMatchTimeoutHrs Int         @default(48) @map("auto_match_timeout_hrs")
  status              EventStatus @default(draft)
  settings            Json        @default("{}")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  organizer            User                     @relation("EventOrganizer", fields: [organizerId], references: [id])
  requiredSkills       EventRequiredSkill[]
  requiredRoles        EventRequiredRole[]
  participants         EventParticipant[]
  teams                Team[]
  provisionalTeams     ProvisionalTeam[]
  requests             RequestInvitation[]
  notifications        Notification[]
  matchingRounds       MatchingRound[]

  @@index([status])
  @@index([organizerId])
  @@map("events")
}

model EventRequiredSkill {
  id             String         @id @default(uuid())
  eventId        String         @map("event_id")
  skillName      String         @map("skill_name")
  constraintType ConstraintType @map("constraint_type")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, skillName])
  @@map("event_required_skills")
}

model EventRequiredRole {
  id             String         @id @default(uuid())
  eventId        String         @map("event_id")
  roleName       String         @map("role_name")
  constraintType ConstraintType @map("constraint_type")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, roleName])
  @@map("event_required_roles")
}

// ─────────────────────────────────────────
// EVENT PARTICIPANTS (Central availability state)
// ─────────────────────────────────────────

model EventParticipant {
  id                  String          @id @default(uuid())
  eventId             String          @map("event_id")
  userId              String          @map("user_id")
  status              UserEventStatus @default(registered)
  teamId              String?         @map("team_id")
  provisionalTeamId   String?         @map("provisional_team_id")
  matchmakingRestarts Int             @default(0) @map("matchmaking_restarts")
  lastMatchmakingAt   DateTime?       @map("last_matchmaking_at")
  profileSnapshot     Json?           @map("profile_snapshot")
  registeredAt        DateTime        @default(now()) @map("registered_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team?            @relation("ParticipantTeam", fields: [teamId], references: [id])
  provisionalTeam ProvisionalTeam? @relation("ParticipantProvisional", fields: [provisionalTeamId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_participants")
}

// ─────────────────────────────────────────
// TEAMS
// ─────────────────────────────────────────

model Team {
  id           String     @id @default(uuid())
  eventId      String     @map("event_id")
  name         String
  description  String?
  ownerId      String     @map("owner_id")
  status       TeamStatus @default(forming)
  recruiting   Boolean    @default(false)
  projectIdea  String?    @map("project_idea")
  chatRoomId   String?    @map("chat_room_id")
  source       TeamSource @default(manual)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner             User                @relation("TeamOwner", fields: [ownerId], references: [id])
  members           TeamMember[]
  requirements      TeamRequirement[]
  participants      EventParticipant[]  @relation("ParticipantTeam")
  requests          RequestInvitation[]
  chatRoom          ChatRoom?           @relation("TeamChatRoom", fields: [chatRoomId], references: [id])
  convertedFrom     ProvisionalTeam?    @relation("ConvertedTeam")

  @@index([eventId, status])
  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id           String    @id @default(uuid())
  teamId       String    @map("team_id")
  userId       String    @map("user_id")
  roleInTeam   TeamMemberRole @default(member) @map("role_in_team")
  assignedRole String?   @map("assigned_role")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamRequirement {
  id              String              @id @default(uuid())
  teamId          String              @map("team_id")
  requirementType RequirementType     @map("requirement_type")
  name            String
  priority        RequirementPriority

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, requirementType, name])
  @@index([teamId])
  @@map("team_requirements")
}

// ─────────────────────────────────────────
// PROVISIONAL TEAMS
// ─────────────────────────────────────────

model ProvisionalTeam {
  id                String                @id @default(uuid())
  eventId           String                @map("event_id")
  status            ProvisionalTeamStatus @default(pending)
  matchScore        Decimal?              @map("match_score") @db.Decimal(5, 3)
  matchExplanation  Json?                 @map("match_explanation")
  createdByRound    String?               @map("created_by_round")
  chatRoomId        String?               @unique @map("chat_room_id")
  expiresAt         DateTime              @map("expires_at")
  finalizedTeamId   String?               @unique @map("finalized_team_id")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members        ProvisionalTeamMember[]
  participants   EventParticipant[]      @relation("ParticipantProvisional")
  chatRoom       ChatRoom?               @relation("ProvisionalChatRoom", fields: [chatRoomId], references: [id])
  finalizedTeam  Team?                   @relation("ConvertedTeam", fields: [finalizedTeamId], references: [id])

  @@index([eventId, status])
  @@map("provisional_teams")
}

model ProvisionalTeamMember {
  id                  String                   @id @default(uuid())
  provisionalTeamId   String                   @map("provisional_team_id")
  userId              String                   @map("user_id")
  status              ProvisionalMemberStatus  @default(pending)
  matchReason         Json?                    @map("match_reason")
  respondedAt         DateTime?                @map("responded_at")
  createdAt           DateTime                 @default(now()) @map("created_at")

  provisionalTeam ProvisionalTeam @relation(fields: [provisionalTeamId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provisionalTeamId, userId])
  @@index([provisionalTeamId, status])
  @@index([userId])
  @@map("provisional_team_members")
}

// ─────────────────────────────────────────
// REQUESTS & INVITATIONS
// ─────────────────────────────────────────

model RequestInvitation {
  id          String        @id @default(uuid())
  eventId     String        @map("event_id")
  type        RequestType
  senderId    String        @map("sender_id")
  recipientId String        @map("recipient_id")
  teamId      String?       @map("team_id")
  status      RequestStatus @default(pending)
  message     String?
  expiresAt   DateTime?     @map("expires_at")
  respondedAt DateTime?     @map("responded_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender    User   @relation("RequestSender", fields: [senderId], references: [id])
  recipient User   @relation("RequestRecipient", fields: [recipientId], references: [id])
  team      Team?  @relation(fields: [teamId], references: [id])

  @@index([recipientId, status])
  @@index([senderId, status])
  @@index([teamId, status])
  @@map("requests_invitations")
}

// ─────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────

model ChatRoom {
  id        String         @id @default(uuid())
  roomType  ChatRoomType   @map("room_type")
  status    ChatRoomStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")

  messages        ChatMessage[]
  teamRooms       Team[]           @relation("TeamChatRoom")
  provisionalRoom ProvisionalTeam? @relation("ProvisionalChatRoom")

  @@map("chat_rooms")
}

model ChatMessage {
  id          String      @id @default(uuid())
  roomId      String      @map("room_id")
  senderId    String      @map("sender_id")
  content     String
  messageType MessageType @default(text) @map("message_type")
  isDeleted   Boolean     @default(false) @map("is_deleted")
  createdAt   DateTime    @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("chat_messages")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  eventId   String?  @map("event_id")
  type      String
  title     String
  body      String?
  data      Json     @default("{}")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────────────────────
// MATCHMAKING ROUNDS
// ─────────────────────────────────────────

model MatchingRound {
  id                String              @id @default(uuid())
  eventId           String              @map("event_id")
  status            MatchingRoundStatus @default(running)
  participantsCount Int?                @map("participants_count")
  teamsFormed       Int?                @map("teams_formed")
  unmatchedCount    Int?                @map("unmatched_count")
  algorithmParams   Json?               @map("algorithm_params")
  startedAt         DateTime            @default(now()) @map("started_at")
  completedAt       DateTime?           @map("completed_at")

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("matching_rounds")
}
